# ---------------------------------------------------------------------------
# Origen de datos de la app
#   mock → msw intercepta las llamadas en el navegador; no hace falta el backend.
#   api  → llamadas reales al NestJS de apps/api (arráncalo antes: `pnpm dev`).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE=mock

# Base de TODAS las llamadas REST. Ruta **relativa**: el navegador llama al
# propio servidor de Next, que reenvía `/api/v1/*` al backend (ver `rewrites` en
# next.config.ts). Al salir la petición del mismo origen que la página no hay
# CORS que ajustar, ni en local ni detrás de un túnel. En modo `mock` msw
# intercepta esta misma ruta, así que el valor sirve para los dos modos.
NEXT_PUBLIC_API_URL=/api/v1

# Backend al que Next reenvía. Sólo lo usa el servidor de Next, nunca el
# navegador, así que apunta al puerto local aunque la app se sirva por un túnel.
API_PROXY_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Si prefieres que el navegador llame directamente a la API (sin el proxy),
# pon la URL absoluta y añade el origen del frontend a CORS_ORIGIN en
# apps/api/.env:
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
#   CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# ---------------------------------------------------------------------------
