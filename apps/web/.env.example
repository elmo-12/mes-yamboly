# ---------------------------------------------------------------------------
# Origen de datos de la app
#   mock → msw intercepta las llamadas en el navegador; no hace falta el backend.
#   api  → llamadas reales al NestJS de apps/api (arráncalo antes: `pnpm dev`).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DATA_SOURCE=mock

# Base de TODAS las llamadas REST. En modo `mock` msw intercepta esta misma URL,
# así que el valor es el mismo en los dos modos.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ---------------------------------------------------------------------------
# Modo api en un puerto distinto (p. ej. para no chocar con el modo mock):
#   cd apps/web && NEXT_PUBLIC_DATA_SOURCE=api npx next dev -p 3001
# Añade ese origen a CORS_ORIGIN en apps/api/.env:
#   CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# ---------------------------------------------------------------------------
