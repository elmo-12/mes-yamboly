PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Saltos de proxy de confianza (`trust proxy` de Express; por defecto 0). El
# límite de login por IP usa `req.ip`: con la API detrás del proxy de Next
# (`rewrites`) pon 1 y configura `WEB_TRUST_PROXY_HOPS` en la web (ver
# docs/api-contracts.md · auth). Con 0 la IP es la del socket. Si con saltos > 0
# la petición llega sin `X-Forwarded-For`, la IP no es fiable: se omite el
# límite por IP (queda el de cuenta) y se avisa en el log.
# TRUST_PROXY_HOPS=1

# --- Base de datos ---------------------------------------------------------
# PostgreSQL 16 en Docker: levántalo con `pnpm db:up` desde la raíz. Si esta
# variable está definida manda sobre DB_PATH y la API arranca contra Postgres.
DATABASE_URL=postgres://mes:mes_dev@localhost:5432/mes_yamboly

# Respaldo SQLite: se usa cuando DATABASE_URL está vacía o comentada (y siempre
# en los e2e, que fuerzan `:memory:`). Si el archivo no existe se crea y se
# siembra al arrancar.
DB_PATH=./data/mes.sqlite

# Orígenes permitidos, separados por comas. Añade el puerto del modo api
# del frontend si lo levantas aparte (p. ej. 3001).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Microservicio Python de predicción (opcional; sin URL se usa el modelo local
# entrenado y, si tampoco lo hay, las reglas deterministas)
PREDICTION_SERVICE_URL=
PREDICTION_TIMEOUT_MS=1500

# Token compartido con `services/prediccion-py` (cabecera `X-Internal-Token`)
# para las mutaciones que expone ese servicio: POST /entrenar y
# POST /modelo/{objetivo}/{version}/activar|desactivar. Debe coincidir con
# PREDICCION_TOKEN del `.env` de `services/prediccion-py`. Vacío = sin
# autenticación (desarrollo local; ese puerto sólo se publica en 127.0.0.1).
PREDICCION_TOKEN=

# Ciclo de inferencia de analítica: cron cada 15 min que puntúa las 9 líneas,
# escribe `prediccion` y dispara el motor de alertas, más el cierre diario del
# backtest a las 06:15. Ponlo en `false` en las réplicas que no deban ejecutarlo
# (los e2e lo apagan solos con NODE_ENV=test).
INFERENCIA_ACTIVA=true

# --- Sincronización con el sistema real ------------------------------------
# Base PostgreSQL del sistema en producción (yamboli-back · Strapi 5), abierta
# SIEMPRE en sólo lectura. La usan dos cosas:
#  - `pnpm sync:real` (a mano). Si no está definida, el script lee las claves
#    DATABASE_* del .env de yamboli-back apuntado por ORIGEN_ENV_YAMBOLI_BACK.
#  - la API: si está definida, trae cada ORDENES_SAP_INTERVALO_MIN minutos las
#    órdenes SAP pendientes (`orden_fabricacion_dbs`) para el wizard «Iniciar
#    orden» y habilita POST /ordenes-sap/sincronizar. Sin ella el job queda
#    desactivado (la API nunca lee el .env de yamboli-back).
# ORIGEN_DATABASE_URL=postgres://usuario_solo_lectura:clave@host:5432/sitemaster
# ORDENES_SAP_INTERVALO_MIN=5
ORIGEN_ENV_YAMBOLI_BACK=../../../yamboli-back/.env

# --- Sensores IoT (iot-yambo) -----------------------------------------------
# API REST del servicio IoT (sensores ESP32 → MQTT → Postgres) de la que el
# tablero de Tiempo real toma el producido y la velocidad REALES de las líneas
# instrumentadas. Integración ESTRICTAMENTE DE SÓLO LECTURA: la API sólo hace
# GET /api/lineales, GET /api/lineales/estado y
# GET /api/lineales/:lineal/conteo?desde&hasta (conteo de la orden en curso
# desde su inicio); nunca escribe en el IoT. URL y clave son las mismas que usa
# yamboli-back (`IOT_API_URL`/`IOT_API_KEY`; la clave es el `API_KEY` del .env
# de iot-yambo). Sin URL o sin clave la integración queda desactivada y el
# tablero usa los registros manuales. Consumo: ≤ 19 peticiones/min con 1 línea
# y ≤ 31/min con 3 (límite del IoT: READ_RATE_LIMIT_MAX, 120/min por IP).
# IOT_API_URL=https://api-iot.example.com
# IOT_API_KEY=
# IOT_TIMEOUT_MS=3000
# Líneas enlazadas (vacía = todas las que tengan lineal homónima con sensores).
# `LIN-MOLD-A2` y `LIN-EXTR-3` también tienen sensores, pero su lineal aún no
# tiene `velocidad_nominal_uph` en el IoT (el detector de paradas no las afina).
# IOT_LINEAS=LIN-MOLD-A3
