PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# SQLite de demo: si el archivo no existe se crea y se siembra al arrancar.
DB_PATH=./data/mes.sqlite

# Orígenes permitidos, separados por comas. Añade el puerto del modo api
# del frontend si lo levantas aparte (p. ej. 3001).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Microservicio Python de predicción (opcional; sin URL se usan reglas)
PREDICTION_SERVICE_URL=
PREDICTION_TIMEOUT_MS=1500
