# Directorio donde se guardan los .joblib y registro.json por objetivo.
# En Docker se monta como volumen nombrado (ver docker-compose.yml, servicio
# `prediccion`).
MODELOS_DIR=./modelos

# Token compartido con Nest para las mutaciones (POST /entrenar,
# POST /modelo/{objetivo}/{version}/activar, POST /modelo/{objetivo}/desactivar).
# Vacío = sin autenticación (desarrollo local; el puerto sólo se publica en
# 127.0.0.1). Debe coincidir con PREDICCION_TOKEN del lado Nest.
PREDICCION_TOKEN=

# Cuántas versiones por objetivo se conservan en el registro; la activa
# nunca se borra aunque supere este número.
RETENCION_VERSIONES=12

# Semilla por defecto si /entrenar no manda una explícita.
SEMILLA_DEFECTO=42

ZONA_HORARIA=America/Lima
