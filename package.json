{
  "name": "mes-yamboly",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "pnpm --filter @mes/api seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrar": "pnpm --filter @mes/api migrar:pg",
    "sync:real": "pnpm --filter @mes/api sincronizar",
    "simular": "pnpm --filter @mes/api simular",
    "clean": "turbo run clean && rm -rf node_modules",
    "py:sync": "cd services/prediccion-py && uv sync",
    "py:test": "cd services/prediccion-py && uv run pytest -q",
    "py:dev": "cd services/prediccion-py && uv run uvicorn prediccion.main:app --reload --port 8001",
    "prediccion:up": "docker compose up -d prediccion",
    "prediccion:logs": "docker compose logs -f prediccion",
    "prediccion:build": "docker compose build prediccion",
    "tunel:web": "cd apps/web && cp tsconfig.json /tmp/mes-tsconfig.bak && NEXT_DIST_DIR=.next-tunel API_PROXY_URL=http://localhost:4000 pnpm exec next build; cp /tmp/mes-tsconfig.bak tsconfig.json && NEXT_DIST_DIR=.next-tunel API_PROXY_URL=http://localhost:4000 WEB_TRUST_PROXY_HOPS=1 pnpm exec next start -p 3300",
    "tunel": "cloudflared --config \"${TUNEL_CONFIG:-$HOME/.cloudflared/mes-yamboly-dev.yml}\" tunnel run"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  }
}
